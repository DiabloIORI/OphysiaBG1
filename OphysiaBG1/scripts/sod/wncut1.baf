IF
	True()
THEN
	RESPONSE #100
	CutsceneId(Player1)
	StartCutsceneMode()
Wait(1)
DisplayStringHead("WNMADRI",~嗯……刚才是怎么说的来着？~)
Wait(1)
ActionOverride("WNMADRI",SwingOnce())
CreateVisualEffectObject("SPSTRENH","WNMADRI")
